@@ -0,0 +1,123 @@
+package org.telegram.ui.fxios;
+
+import org.telegram.messenger.ChatObject;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.R;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * Local quick filter for the "All chats" list. It never creates or edits server
+ * chat folders; it only narrows what the main list shows on this device.
+ * The filtered snapshot is rebuilt when the dialogs adapter rebuilds its rows,
+ * so positions used for taps always match what is on screen.
+ */
+public final class FxChatFilter {
+    private FxChatFilter() {}
+
+    public static final int ALL = 0, UNREAD = 1, PERSONAL = 2, GROUPS = 3, CHANNELS = 4, BOTS = 5;
+    public static final int[] MODES = {ALL, UNREAD, PERSONAL, GROUPS, CHANNELS, BOTS};
+
+    private static int mode = ALL;
+    private static int generation;
+
+    private static ArrayList<TLRPC.Dialog> cacheSource;
+    private static int cacheSourceSize = -1, cacheMode = -1, cacheGeneration = -1, cacheAccount = -1;
+    private static ArrayList<TLRPC.Dialog> cache = new ArrayList<>();
+
+    public static int getMode() {
+        return mode;
+    }
+
+    public static boolean isActive() {
+        return mode != ALL;
+    }
+
+    public static void setMode(int newMode) {
+        mode = newMode;
+        invalidate();
+    }
+
+    /** Called right before the chat list rebuilds its rows. */
+    public static void invalidate() {
+        generation++;
+    }
+
+    public static int iconRes(int m) {
+        switch (m) {
+            case UNREAD: return R.drawable.msg_markunread;
+            case PERSONAL: return R.drawable.msg_openprofile;
+            case GROUPS: return R.drawable.msg_groups;
+            case CHANNELS: return R.drawable.msg_channel;
+            case BOTS: return R.drawable.msg_bots;
+            default: return R.drawable.fx_filter_24;
+        }
+    }
+
+    public static String title(int m) {
+        switch (m) {
+            case UNREAD: return LocaleController.getString(R.string.FxFilterUnread);
+            case PERSONAL: return LocaleController.getString(R.string.FxFilterPersonal);
+            case GROUPS: return LocaleController.getString(R.string.FxFilterGroups);
+            case CHANNELS: return LocaleController.getString(R.string.FxFilterChannels);
+            case BOTS: return LocaleController.getString(R.string.FxFilterBots);
+            default: return LocaleController.getString(R.string.FxFilterAll);
+        }
+    }
+
+    public static ArrayList<TLRPC.Dialog> apply(int account, ArrayList<TLRPC.Dialog> source) {
+        if (mode == ALL || source == null) {
+            return source;
+        }
+        if (source == cacheSource && source.size() == cacheSourceSize && cacheMode == mode
+                && cacheGeneration == generation && cacheAccount == account) {
+            return cache;
+        }
+        // A fresh list each time: callers may still hold the previous snapshot while diffing.
+        final ArrayList<TLRPC.Dialog> result = new ArrayList<>();
+        MessagesController controller = MessagesController.getInstance(account);
+        for (int i = 0, n = source.size(); i < n; i++) {
+            TLRPC.Dialog dialog = source.get(i);
+            if (dialog != null && matches(controller, account, dialog)) {
+                result.add(dialog);
+            }
+        }
+        cache = result;
+        cacheSource = source;
+        cacheSourceSize = source.size();
+        cacheMode = mode;
+        cacheGeneration = generation;
+        cacheAccount = account;
+        return cache;
+    }
+
+    private static boolean matches(MessagesController controller, int account, TLRPC.Dialog dialog) {
+        if (dialog instanceof TLRPC.TL_dialogFolder) {
+            return false;
+        }
+        final long id = dialog.id;
+        switch (mode) {
+            case UNREAD:
+                return dialog.unread_count > 0 || dialog.unread_mark || dialog.unread_mentions_count > 0;
+            case PERSONAL: {
+                if (!DialogObject.isUserDialog(id)) return false;
+                TLRPC.User user = controller.getUser(id);
+                return user == null || !user.bot;
+            }
+            case BOTS: {
+                if (!DialogObject.isUserDialog(id)) return false;
+                TLRPC.User user = controller.getUser(id);
+                return user != null && user.bot;
+            }
+            case GROUPS:
+                return DialogObject.isChatDialog(id) && !ChatObject.isChannelAndNotMegaGroup(-id, account);
+            case CHANNELS:
+                return DialogObject.isChatDialog(id) && ChatObject.isChannelAndNotMegaGroup(-id, account);
+            default:
+                return true;
+        }
+    }
+}
