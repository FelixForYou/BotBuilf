diff --git a/TMessagesProj/src/main/java/org/telegram/ui/fxios/FxMotion.java b/TMessagesProj/src/main/java/org/telegram/ui/fxios/FxMotion.java
new file mode 100644
index 0000000..8e92b5a
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/fxios/FxMotion.java
@@ -0,0 +1,204 @@
+package org.telegram.ui.fxios;
+
+import android.animation.ValueAnimator;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.view.animation.Interpolator;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.LiteMode;
+import org.telegram.messenger.SharedConfig;
+
+/**
+ * Central motion and Liquid Glass quality policy.
+ *
+ * Every value is resolved from cached ints so it is safe to call while drawing.
+ * "Auto" picks a level from the device performance class and Android version;
+ * the user can override both choices in FxBgraM settings.
+ */
+public final class FxMotion {
+    private FxMotion() {}
+
+    public static final int MOTION_AUTO = 0, MOTION_FULL = 1, MOTION_REDUCED = 2, MOTION_OFF = 3;
+    public static final int GLASS_AUTO = 0, GLASS_OFF = 1, GLASS_SIMPLE = 2, GLASS_STANDARD = 3, GLASS_RICH = 4;
+
+    private static final String PREFS = "fxbgram_ios_addons";
+    private static final String KEY_MOTION = "motion_mode";
+    private static final String KEY_GLASS = "glass_level";
+
+    private static boolean loaded;
+    private static int motionMode = MOTION_AUTO;
+    private static int glassMode = GLASS_AUTO;
+    private static int autoMotion = -1;
+    private static int autoGlass = -1;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, 0);
+    }
+
+    private static void load() {
+        if (loaded || ApplicationLoader.applicationContext == null) return;
+        SharedPreferences p = prefs();
+        motionMode = clamp(p.getInt(KEY_MOTION, MOTION_AUTO), MOTION_AUTO, MOTION_OFF);
+        glassMode = clamp(p.getInt(KEY_GLASS, GLASS_AUTO), GLASS_AUTO, GLASS_RICH);
+        loaded = true;
+    }
+
+    private static int clamp(int v, int min, int max) {
+        return Math.max(min, Math.min(max, v));
+    }
+
+    public static int getMotionSetting() { load(); return motionMode; }
+    public static int getGlassSetting() { load(); return glassMode; }
+
+    public static void setMotionSetting(int mode) {
+        load();
+        motionMode = clamp(mode, MOTION_AUTO, MOTION_OFF);
+        if (ApplicationLoader.applicationContext != null) prefs().edit().putInt(KEY_MOTION, motionMode).apply();
+    }
+
+    public static void setGlassSetting(int level) {
+        load();
+        glassMode = clamp(level, GLASS_AUTO, GLASS_RICH);
+        if (ApplicationLoader.applicationContext != null) prefs().edit().putInt(KEY_GLASS, glassMode).apply();
+    }
+
+    /** Automatic motion level for this device (system "remove animations" always wins). */
+    public static int autoMotion() {
+        if (autoMotion < 0) {
+            autoMotion = SharedConfig.getDevicePerformanceClass() == SharedConfig.PERFORMANCE_CLASS_LOW ? MOTION_REDUCED : MOTION_FULL;
+        }
+        return autoMotion;
+    }
+
+    /** Automatic glass level: real-time refraction needs RenderNode effects (API 31+) and a capable GPU. */
+    public static int autoGlass() {
+        if (autoGlass < 0) {
+            if (Build.VERSION.SDK_INT < 31) {
+                autoGlass = GLASS_SIMPLE;
+            } else {
+                int perf = SharedConfig.getDevicePerformanceClass();
+                // Owner's Vivo Y17s (V2310): v8 already enabled the full glass renderer for it.
+                final boolean vivoY17s = "vivo".equalsIgnoreCase(Build.MANUFACTURER)
+                    && ("V2310".equalsIgnoreCase(Build.MODEL) || "vivo Y17s".equalsIgnoreCase(Build.MODEL));
+                if (vivoY17s && Build.VERSION.SDK_INT >= 33) {
+                    autoGlass = GLASS_RICH;
+                } else if (perf == SharedConfig.PERFORMANCE_CLASS_LOW) {
+                    autoGlass = GLASS_SIMPLE;
+                } else if (perf == SharedConfig.PERFORMANCE_CLASS_AVERAGE && Build.VERSION.SDK_INT < 33) {
+                    autoGlass = GLASS_STANDARD;
+                } else {
+                    autoGlass = GLASS_RICH;
+                }
+            }
+        }
+        return autoGlass;
+    }
+
+    public static int motion() {
+        load();
+        if (Build.VERSION.SDK_INT >= 26 && !ValueAnimator.areAnimatorsEnabled()) return MOTION_OFF;
+        return motionMode == MOTION_AUTO ? autoMotion() : motionMode;
+    }
+
+    public static int glass() {
+        load();
+        int level = glassMode == GLASS_AUTO ? autoGlass() : glassMode;
+        if (Build.VERSION.SDK_INT < 31 && level > GLASS_SIMPLE) {
+            // RenderNode blur is not available: keep the glass look with the light renderer.
+            level = GLASS_SIMPLE;
+        }
+        return level;
+    }
+
+    /** Removes LiteMode flags that the selected glass level does not allow. */
+    public static int maskLiteFlag(int flag) {
+        int level = glass();
+        if (level < GLASS_RICH) flag &= ~LiteMode.FLAG_LIQUID_GLASS;
+        if (level < GLASS_STANDARD) flag &= ~LiteMode.FLAG_CHAT_BLUR;
+        return flag;
+    }
+
+    public static boolean animationsEnabled() { return motion() != MOTION_OFF; }
+    public static boolean reduced() { return motion() != MOTION_FULL; }
+
+    /** Duration of push/pop page transitions in ms. 0 means no animation. */
+    public static float pageDuration(boolean open) {
+        switch (motion()) {
+            case MOTION_OFF: return 1f;
+            case MOTION_REDUCED: return 190f;
+            default: return open ? 330f : 300f;
+        }
+    }
+
+    /** Parallax factor of the page underneath (iOS moves it by about 30%). */
+    public static float pageParallax() {
+        return motion() == MOTION_FULL ? 0.3f : 0f;
+    }
+
+    /** Pager slide when a bottom tab is tapped; kept in step with the glass lens spring. */
+    public static long tabSwitchDuration() {
+        switch (motion()) {
+            case MOTION_OFF: return 0L;
+            case MOTION_REDUCED: return 180L;
+            default: return 300L;
+        }
+    }
+
+    public static float tabStiffness() {
+        switch (motion()) {
+            case MOTION_REDUCED: return 1400f;
+            default: return 560f;
+        }
+    }
+
+    public static float tabDamping() {
+        return motion() == MOTION_FULL ? 0.74f : 1f;
+    }
+
+    /** Elastic deformation multiplier of the sliding glass lens. */
+    public static float lensElasticity() {
+        return motion() == MOTION_FULL ? 1f : 0f;
+    }
+
+    public static Interpolator pageInterpolator() {
+        return motion() == MOTION_FULL ? SPRING_CRITICAL : SPRING_FAST;
+    }
+
+    /** iOS-like critically damped spring, normalised so that it reaches exactly 1 at t = 1. */
+    public static final Interpolator SPRING_CRITICAL = new SpringInterpolator(1f, 9.2f);
+    /** Shorter spring for reduced motion. */
+    public static final Interpolator SPRING_FAST = new SpringInterpolator(1f, 7f);
+    /** Slightly under-damped spring for popups and glass lens settling. */
+    public static final Interpolator SPRING_SOFT = new SpringInterpolator(0.78f, 10f);
+
+    public static final class SpringInterpolator implements Interpolator {
+        private final float zeta, omega, end;
+
+        /**
+         * @param dampingRatio 1 = critical (no overshoot), &lt;1 = a little bounce
+         * @param omega natural frequency expressed per animation duration
+         */
+        public SpringInterpolator(float dampingRatio, float omega) {
+            this.zeta = dampingRatio;
+            this.omega = omega;
+            this.end = raw(1f);
+        }
+
+        private float raw(float t) {
+            if (zeta >= 1f) {
+                return (float) (1 - (1 + omega * t) * Math.exp(-omega * t));
+            }
+            double wd = omega * Math.sqrt(1 - zeta * zeta);
+            double e = Math.exp(-zeta * omega * t);
+            return (float) (1 - e * (Math.cos(wd * t) + zeta * omega / wd * Math.sin(wd * t)));
+        }
+
+        @Override
+        public float getInterpolation(float t) {
+            if (t <= 0f) return 0f;
+            if (t >= 1f) return 1f;
+            return raw(t) / end;
+        }
+    }
+}
