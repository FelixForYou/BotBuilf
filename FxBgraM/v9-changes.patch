@@ -0,0 +1,245 @@
+package org.telegram.ui.fxios;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.view.View;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.DownloadController;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.R;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.ActionBarMenu;
+import org.telegram.ui.ActionBar.ActionBarMenuItem;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.CacheControlActivity;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.SearchDownloadsContainer;
+import org.telegram.ui.FilteredSearchView;
+
+import java.util.ArrayList;
+
+/**
+ * Stand-alone download manager. It reuses the native download engine and list
+ * (progress, per-file pause/resume by tapping, media/document preview) that the
+ * stock client only exposes inside global search, and adds bulk controls.
+ */
+public class FxDownloadsActivity extends BaseFragment implements NotificationCenter.NotificationCenterDelegate {
+
+    private static final int ID_SEARCH = 1, ID_MORE = 2;
+    private static final int ID_PAUSE_ALL = 10, ID_RESUME_ALL = 11, ID_CLEAR_RECENT = 12, ID_STORAGE = 13;
+
+    private SearchDownloadsContainer container;
+    private ActionBarMenuItem moreItem;
+
+    @Override
+    public boolean onFragmentCreate() {
+        getNotificationCenter().addObserver(this, NotificationCenter.onDownloadingFilesChanged);
+        return super.onFragmentCreate();
+    }
+
+    @Override
+    public void onFragmentDestroy() {
+        getNotificationCenter().removeObserver(this, NotificationCenter.onDownloadingFilesChanged);
+        super.onFragmentDestroy();
+    }
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setTitle(LocaleController.getString(R.string.FxDownloadsTitle));
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                } else if (id == ID_PAUSE_ALL) {
+                    pauseAll();
+                } else if (id == ID_RESUME_ALL) {
+                    resumeAll();
+                } else if (id == ID_CLEAR_RECENT) {
+                    confirmClearRecent();
+                } else if (id == ID_STORAGE) {
+                    presentFragment(new CacheControlActivity());
+                }
+            }
+        });
+
+        ActionBarMenu menu = actionBar.createMenu();
+        ActionBarMenuItem searchItem = menu.addItem(ID_SEARCH, R.drawable.outline_header_search).setIsSearchField(true)
+            .setActionBarMenuItemSearchListener(new ActionBarMenuItem.ActionBarMenuItemSearchListener() {
+                @Override
+                public void onTextChanged(EditText editText) {
+                    if (container != null) container.search(editText.getText().toString());
+                }
+
+                @Override
+                public void onSearchCollapse() {
+                    if (container != null) container.search(null);
+                }
+            });
+        searchItem.setSearchFieldHint(LocaleController.getString(R.string.Search));
+        moreItem = menu.addItem(ID_MORE, R.drawable.ic_ab_other);
+        moreItem.addSubItem(ID_PAUSE_ALL, R.drawable.fx_pause_24, LocaleController.getString(R.string.FxDownloadsPauseAll));
+        moreItem.addSubItem(ID_RESUME_ALL, R.drawable.fx_play_24, LocaleController.getString(R.string.FxDownloadsResumeAll));
+        moreItem.addSubItem(ID_CLEAR_RECENT, R.drawable.msg_clear_recent, LocaleController.getString(R.string.FxDownloadsClearRecent));
+        moreItem.addSubItem(ID_STORAGE, R.drawable.fx_storage_24, LocaleController.getString(R.string.StorageUsage));
+
+        FrameLayout frame = new FrameLayout(context);
+        frame.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+        container = new SearchDownloadsContainer(this, currentAccount);
+        container.setUiCallback(new FilteredSearchView.UiCallback() {
+            @Override
+            public void goToMessage(MessageObject messageObject) {
+                openMessage(messageObject);
+            }
+
+            @Override
+            public boolean actionModeShowing() {
+                return false;
+            }
+
+            @Override
+            public void toggleItemSelection(MessageObject item, View view, int a) {
+            }
+
+            @Override
+            public boolean isSelected(FilteredSearchView.MessageHashId messageHashId) {
+                return false;
+            }
+
+            @Override
+            public void showActionMode() {
+                // Long press opens the message in its chat (there is no bulk selection here).
+            }
+
+            @Override
+            public int getFolderId() {
+                return 0;
+            }
+        });
+        frame.addView(container, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        fragmentView = frame;
+        updateMenu();
+        return fragmentView;
+    }
+
+    private void openMessage(MessageObject messageObject) {
+        if (messageObject == null) return;
+        Bundle args = new Bundle();
+        long dialogId = messageObject.getDialogId();
+        if (DialogObject.isUserDialog(dialogId)) {
+            args.putLong("user_id", dialogId);
+        } else {
+            args.putLong("chat_id", -dialogId);
+        }
+        args.putInt("message_id", messageObject.getId());
+        presentFragment(new ChatActivity(args));
+    }
+
+    private ArrayList<MessageObject> currentFiles() {
+        ArrayList<MessageObject> list = new ArrayList<>();
+        FileLoader.getInstance(currentAccount).getCurrentLoadingFiles(list);
+        return list;
+    }
+
+    private boolean isActive(MessageObject messageObject) {
+        return FileLoader.getInstance(currentAccount).isLoadingFile(messageObject.getFileName());
+    }
+
+    private void pauseAll() {
+        int count = 0;
+        for (MessageObject messageObject : currentFiles()) {
+            TLRPC.Document document = messageObject.getDocument();
+            if (document != null && isActive(messageObject)) {
+                // cancelLoadFile keeps the partial file, so the download resumes from the same offset.
+                FileLoader.getInstance(currentAccount).cancelLoadFile(document);
+                count++;
+            }
+        }
+        refresh(count, R.string.FxDownloadsPausedCount);
+    }
+
+    private void resumeAll() {
+        int count = 0;
+        for (MessageObject messageObject : currentFiles()) {
+            TLRPC.Document document = messageObject.getDocument();
+            if (document != null && !isActive(messageObject)) {
+                messageObject.putInDownloadsStore = true;
+                FileLoader.getInstance(currentAccount).loadFile(document, messageObject, FileLoader.PRIORITY_LOW, 0);
+                count++;
+            }
+        }
+        if (count > 0) {
+            DownloadController.getInstance(currentAccount).updateFilesLoadingPriority();
+        }
+        refresh(count, R.string.FxDownloadsResumedCount);
+    }
+
+    private void refresh(int count, int stringRes) {
+        if (container != null) container.update(true);
+        updateMenu();
+        if (count > 0) {
+            BulletinFactory.of(this).createSimpleBulletin(stringRes == R.string.FxDownloadsPausedCount ? R.drawable.fx_pause_24 : R.drawable.fx_play_24,
+                LocaleController.formatString(stringRes, count)).show();
+        } else {
+            BulletinFactory.of(this).createSimpleBulletin(R.drawable.fx_downloads_24, LocaleController.getString(R.string.FxDownloadsNothing)).show();
+        }
+    }
+
+    private void confirmClearRecent() {
+        if (getParentActivity() == null) return;
+        AlertDialog.Builder builder = new AlertDialog.Builder(getParentActivity());
+        builder.setTitle(LocaleController.getString(R.string.FxDownloadsClearRecent));
+        builder.setMessage(LocaleController.getString(R.string.FxDownloadsClearRecentInfo));
+        builder.setPositiveButton(LocaleController.getString(R.string.Clear), (dialog, which) -> {
+            DownloadController.getInstance(currentAccount).clearRecentDownloadedFiles();
+            if (container != null) container.update(true);
+            updateMenu();
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
+        AlertDialog dialog = builder.create();
+        showDialog(dialog);
+        View button = dialog.getButton(AlertDialog.BUTTON_POSITIVE);
+        if (button instanceof android.widget.TextView) {
+            ((android.widget.TextView) button).setTextColor(Theme.getColor(Theme.key_text_RedBold));
+        }
+    }
+
+    private void updateMenu() {
+        if (moreItem == null) return;
+        boolean hasActive = false, hasPaused = false;
+        for (MessageObject messageObject : currentFiles()) {
+            if (messageObject.getDocument() == null) continue;
+            if (isActive(messageObject)) hasActive = true; else hasPaused = true;
+        }
+        moreItem.setSubItemShown(ID_PAUSE_ALL, hasActive);
+        moreItem.setSubItemShown(ID_RESUME_ALL, hasPaused);
+        moreItem.setSubItemShown(ID_CLEAR_RECENT, !DownloadController.getInstance(currentAccount).recentDownloadingFiles.isEmpty());
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        if (id == NotificationCenter.onDownloadingFilesChanged) {
+            updateMenu();
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        if (container != null) container.update(false);
+        updateMenu();
+    }
+}
