+ /** Real-time blurred glass (standard or rich level) is active. */
+ public static boolean isEnabled(){return isSupported()&&LiteMode.isEnabled(LiteMode.FLAG_CHAT_BLUR);}
+ /** Refraction lens (rich level) is active. */
+ public static boolean isRefractionEnabled(){return isEnabled()&&LiteMode.isEnabled(LiteMode.FLAG_LIQUID_GLASS);}
+ /** Specular highlight and rim are drawn for every level except "off" (cheap, no blur). */
+ public static boolean highlights(){return FxMotion.glass()>=FxMotion.GLASS_SIMPLE;}
+ /** Tint alpha of a glass surface over blurred content. */
+ public static float tintAlpha(boolean dark){
+  switch(FxMotion.glass()){
+   case FxMotion.GLASS_RICH:return dark?0.20f:0.24f;
+   case FxMotion.GLASS_STANDARD:return dark?0.34f:0.40f;
+   default:return surfaceAlpha(dark);
+  }
+ }
+ /** Alpha of a bar/panel surface; without blur it stays readable (simple glass) or opaque (off). */
+ public static float surfaceAlpha(boolean dark){
+  if(isEnabled())return tintAlpha(dark);
+  return FxMotion.glass()==FxMotion.GLASS_OFF?1f:(dark?0.90f:0.92f);
+ }
 }
