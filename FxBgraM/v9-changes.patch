@@ -0,0 +1,160 @@
+package org.telegram.ui.fxios;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.view.MotionEvent;
+import android.view.View;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FxGlassStyle;
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * Small live preview of the selected glass level and motion quality: a tab bar
+ * floating over chat bubbles with the sliding lens. Static until tapped, so it
+ * costs nothing while idle.
+ */
+public class FxGlassPreviewView extends View {
+    private final Paint bg = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint bubble = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint bar = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint sheen = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint rim = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint lens = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint dot = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private float position = 1f, from = 1f, to = 1f, velocityHint;
+    private ValueAnimator animator;
+    private int shaderHeight = -1, shaderDark = -1;
+
+    public FxGlassPreviewView(Context context) {
+        super(context);
+        setClickable(true);
+        setContentDescription(org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.FxPreviewHint));
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(AndroidUtilities.dp(168), MeasureSpec.EXACTLY));
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (event.getAction() == MotionEvent.ACTION_UP) {
+            int target = (int) Math.max(0, Math.min(2, event.getX() / Math.max(1, getWidth() / 3f)));
+            moveTo(target == Math.round(to) ? (target + 1) % 3 : target);
+            FxIosExperience.selection(this);
+        }
+        return super.onTouchEvent(event) || true;
+    }
+
+    public void moveTo(int target) {
+        if (animator != null) animator.cancel();
+        from = position;
+        to = target;
+        if (!FxMotion.animationsEnabled()) {
+            position = to;
+            invalidate();
+            return;
+        }
+        animator = ValueAnimator.ofFloat(0, 1);
+        animator.setDuration(FxMotion.reduced() ? 200 : 420);
+        animator.setInterpolator(FxMotion.reduced() ? FxMotion.SPRING_FAST : FxMotion.SPRING_SOFT);
+        animator.addUpdateListener(a -> {
+            float old = position;
+            position = from + (to - from) * (float) a.getAnimatedValue();
+            velocityHint = position - old;
+            invalidate();
+        });
+        animator.start();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        if (animator != null) animator.cancel();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        final boolean dark = Theme.isCurrentThemeDark();
+        final int w = getWidth(), h = getHeight();
+        if (h != shaderHeight || (dark ? 1 : 0) != shaderDark) {
+            shaderHeight = h;
+            shaderDark = dark ? 1 : 0;
+            bg.setShader(new LinearGradient(0, 0, 0, h,
+                dark ? new int[]{0xFF1B2733, 0xFF0F1620} : new int[]{0xFFDCE8F5, 0xFFEEF2F8}, null, Shader.TileMode.CLAMP));
+            sheen.setShader(new LinearGradient(0, 0, 0, AndroidUtilities.dp(58),
+                new int[]{dark ? 0x30FFFFFF : 0x80FFFFFF, 0x00FFFFFF}, null, Shader.TileMode.CLAMP));
+        }
+        canvas.drawRect(0, 0, w, h, bg);
+
+        // Chat bubbles scrolling "behind" the bar.
+        final float r = AndroidUtilities.dp(17);
+        bubble.setColor(dark ? 0xFF2C2C2E : 0xFFFFFFFF);
+        rect.set(AndroidUtilities.dp(16), AndroidUtilities.dp(14), w * 0.62f, AndroidUtilities.dp(48));
+        canvas.drawRoundRect(rect, r, r, bubble);
+        bubble.setColor(dark ? 0xFF0A84FF : 0xFF007AFF);
+        rect.set(w * 0.38f, AndroidUtilities.dp(58), w - AndroidUtilities.dp(16), AndroidUtilities.dp(92));
+        canvas.drawRoundRect(rect, r, r, bubble);
+        bubble.setColor(dark ? 0xFF2C2C2E : 0xFFFFFFFF);
+        rect.set(AndroidUtilities.dp(16), AndroidUtilities.dp(102), w * 0.55f, AndroidUtilities.dp(146));
+        canvas.drawRoundRect(rect, r, r, bubble);
+
+        // Floating glass tab bar.
+        final float barH = AndroidUtilities.dp(58);
+        final float top = h - barH - AndroidUtilities.dp(10);
+        final float left = AndroidUtilities.dp(24), right = w - AndroidUtilities.dp(24);
+        rect.set(left, top, right, top + barH);
+        final float alpha = FxGlassStyle.isEnabled() ? FxGlassStyle.tintAlpha(dark) : FxGlassStyle.surfaceAlpha(dark);
+        final int base = dark ? 0x1C1C1E : 0xFFFFFF;
+        bar.setColor(((int) (alpha * 255) << 24) | base);
+        canvas.drawRoundRect(rect, barH / 2, barH / 2, bar);
+        if (FxGlassStyle.highlights()) {
+            canvas.save();
+            canvas.translate(0, top);
+            rect.offset(0, -top);
+            canvas.drawRoundRect(rect, barH / 2, barH / 2, sheen);
+            rect.offset(0, top);
+            canvas.restore();
+            rim.setStyle(Paint.Style.STROKE);
+            rim.setStrokeWidth(AndroidUtilities.dpf2(0.8f));
+            rim.setColor(dark ? 0x55FFFFFF : 0xB3FFFFFF);
+            canvas.drawRoundRect(rect, barH / 2, barH / 2, rim);
+        }
+
+        // Lens: same deformation rules as the real tab bar.
+        final float inset = AndroidUtilities.dp(4);
+        final float slot = (right - left - inset * 2) / 3f;
+        float lL = left + inset + slot * position, lR = lL + slot;
+        final float speed = Math.min(1f, Math.abs(velocityHint) * 18f) * FxMotion.lensElasticity();
+        final float lead = AndroidUtilities.dp(10) * speed, trail = AndroidUtilities.dp(3) * speed;
+        if (velocityHint >= 0) { lR += lead; lL -= trail; } else { lL -= lead; lR += trail; }
+        rect.set(lL, top + inset + AndroidUtilities.dp(2) * speed, lR, top + barH - inset - AndroidUtilities.dp(2) * speed);
+        lens.setStyle(Paint.Style.FILL);
+        lens.setColor(dark ? 0x26FFFFFF : 0x14000000);
+        final float lr = rect.height() / 2;
+        canvas.drawRoundRect(rect, lr, lr, lens);
+        if (FxGlassStyle.highlights()) {
+            canvas.drawRoundRect(rect, lr, lr, rim);
+        }
+
+        // Tab glyphs.
+        for (int i = 0; i < 3; i++) {
+            float cx = left + inset + slot * (i + 0.5f);
+            boolean selected = Math.abs(position - i) < 0.5f;
+            dot.setColor(selected ? (dark ? 0xFF0A84FF : 0xFF007AFF) : (dark ? 0xFF98989D : 0xFF8E8E93));
+            canvas.drawCircle(cx, top + barH / 2 - AndroidUtilities.dp(6), AndroidUtilities.dp(7), dot);
+            rect.set(cx - AndroidUtilities.dp(12), top + barH / 2 + AndroidUtilities.dp(6), cx + AndroidUtilities.dp(12), top + barH / 2 + AndroidUtilities.dp(9));
+            canvas.drawRoundRect(rect, AndroidUtilities.dp(2), AndroidUtilities.dp(2), dot);
+        }
+        if (animator == null || !animator.isRunning()) {
+            velocityHint = 0;
+        }
+    }
+}
