@@ -0,0 +1,7 @@
+package org.telegram.messenger;
+/** Applies the client name to interface copy only, never chat data or protocol identifiers. */
+public final class FxBrand {
+ private FxBrand(){}
+ private static final java.util.regex.Pattern NAME = java.util.regex.Pattern.compile("(?<![A-Za-z0-9_./:@-])Telegram(?![A-Za-z0-9_./-])");
+ public static String text(String value){return value==null?null:NAME.matcher(value).replaceAll("FxBgraM");}
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/FxGlassStyle.java b/TMessagesProj/src/main/java/org/telegram/messenger/FxGlassStyle.java
new file mode 100644
index 0000000..9e49f67
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/FxGlassStyle.java
@@ -0,0 +1,27 @@
+package org.telegram.messenger;
+import android.os.Build;
+import org.telegram.ui.fxios.FxMotion;
+/** Clear glass render policy; respects the FxBgraM glass level and local power-saving controls. */
+public final class FxGlassStyle {
+ private FxGlassStyle() {}
+ public static boolean isSupported(){return Build.VERSION.SDK_INT>=31;}
+ /** Real-time blurred glass (standard or rich level) is active. */
+ public static boolean isEnabled(){return isSupported()&&LiteMode.isEnabled(LiteMode.FLAG_CHAT_BLUR);}
+ /** Refraction lens (rich level) is active. */
+ public static boolean isRefractionEnabled(){return isEnabled()&&LiteMode.isEnabled(LiteMode.FLAG_LIQUID_GLASS);}
+ /** Specular highlight and rim are drawn for every level except "off" (cheap, no blur). */
+ public static boolean highlights(){return FxMotion.glass()>=FxMotion.GLASS_SIMPLE;}
+ /** Tint alpha of a glass surface over blurred content. */
+ public static float tintAlpha(boolean dark){
+  switch(FxMotion.glass()){
+   case FxMotion.GLASS_RICH:return dark?0.20f:0.24f;
+   case FxMotion.GLASS_STANDARD:return dark?0.34f:0.40f;
+   default:return surfaceAlpha(dark);
+  }
+ }
+ /** Alpha of a bar/panel surface; without blur it stays readable (simple glass) or opaque (off). */
+ public static float surfaceAlpha(boolean dark){
+  if(isEnabled())return tintAlpha(dark);
+  return FxMotion.glass()==FxMotion.GLASS_OFF?1f:(dark?0.90f:0.92f);
+ }
+}
