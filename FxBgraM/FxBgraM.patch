+package org.telegram.ui.fxios;
+import android.animation.ValueAnimator;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.view.HapticFeedbackConstants;
+import android.view.MotionEvent;
+import android.view.View;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.ui.Components.CubicBezierInterpolator;
+/** Small, switchable native enhancements; no external plugin process or service. */
+public final class FxIosExperience {
+ private FxIosExperience(){}
+ private static SharedPreferences prefs(){return ApplicationLoader.applicationContext.getSharedPreferences("fxbgram_ios_addons",0);}
+ public static boolean haptics(){return ApplicationLoader.applicationContext!=null&&prefs().getBoolean("haptics",true);}
+ public static boolean pressAnimations(){return ApplicationLoader.applicationContext!=null&&prefs().getBoolean("press_animations",true);}
+ public static void setHaptics(boolean enabled){prefs().edit().putBoolean("haptics",enabled).apply();}
+ public static void setPressAnimations(boolean enabled){prefs().edit().putBoolean("press_animations",enabled).apply();}
+ public static void selection(View view){
+  if(view!=null&&haptics())view.performHapticFeedback(Build.VERSION.SDK_INT>=34?HapticFeedbackConstants.SEGMENT_TICK:HapticFeedbackConstants.CLOCK_TICK);
+ }
+ public static void press(View view,MotionEvent event){
+  int action=event.getActionMasked();
+  if(action!=MotionEvent.ACTION_DOWN&&action!=MotionEvent.ACTION_UP&&action!=MotionEvent.ACTION_CANCEL)return;
+  boolean enabled=pressAnimations()&&FxMotion.animationsEnabled();
+  float scale=enabled&&action==MotionEvent.ACTION_DOWN?.96f:1f;
+  view.animate().cancel();
+  if(!enabled){view.setScaleX(1f);view.setScaleY(1f);return;}
+  view.animate().scaleX(scale).scaleY(scale).setDuration(action==MotionEvent.ACTION_DOWN?100:220).setInterpolator(CubicBezierInterpolator.EASE_OUT_QUINT).start();
+ }
+}
