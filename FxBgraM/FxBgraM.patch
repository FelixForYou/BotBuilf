+package org.telegram.ui.fxios;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import org.telegram.messenger.AndroidUtilities;
+/** Light reflection at the avatar edge; the user's photo remains unmodified. */
+public final class FxGlassAvatarRim extends Drawable {
+ private final Paint paint=new Paint(Paint.ANTI_ALIAS_FLAG);
+ private final RectF oval=new RectF();
+ @Override protected void onBoundsChange(Rect b){
+  float inset=AndroidUtilities.dpf2(.7f);oval.set(b);oval.inset(inset,inset);
+  paint.setShader(new LinearGradient(b.left,b.top,b.right,b.bottom,new int[]{0xEEFFFFFF,0x20FFFFFF,0x99D6EEFF},null,Shader.TileMode.CLAMP));
+  paint.setStyle(Paint.Style.STROKE);paint.setStrokeWidth(AndroidUtilities.dpf2(1.2f));
+ }
+ @Override public void draw(Canvas c){c.drawOval(oval,paint);}
+ @Override public void setAlpha(int a){paint.setAlpha(a);invalidateSelf();}
+ @Override public void setColorFilter(ColorFilter f){paint.setColorFilter(f);invalidateSelf();}
+ @Override public int getOpacity(){return PixelFormat.TRANSLUCENT;}
+}
