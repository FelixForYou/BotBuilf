@@ -0,0 +1,23 @@
+package org.telegram.ui.fxios;
+import android.graphics.Typeface;
+import android.os.Build;
+import android.text.TextPaint;
+import android.util.SparseArray;
+import androidx.core.content.res.ResourcesCompat;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.R;
+public final class FxIosTypography {
+ private static final SparseArray<Typeface> cache = new SparseArray<>();
+ private FxIosTypography() {}
+ public static synchronized Typeface get(int weight, boolean italic) {
+  if (ApplicationLoader.applicationContext == null) return Typeface.create("sans-serif", weight >= 600 ? Typeface.BOLD : Typeface.NORMAL);
+  int key=weight+(italic?1000:0);Typeface t=cache.get(key);
+  if(t==null){
+   try { Typeface base=ResourcesCompat.getFont(ApplicationLoader.applicationContext,italic?R.font.fx_inter_italic:R.font.fx_inter_regular);
+    t=Build.VERSION.SDK_INT>=28?Typeface.create(base,weight,italic):Typeface.create(base,weight>=600?(italic?Typeface.BOLD_ITALIC:Typeface.BOLD):(italic?Typeface.ITALIC:Typeface.NORMAL));
+   } catch(RuntimeException e){t=Typeface.create("sans-serif",weight>=600?Typeface.BOLD:Typeface.NORMAL);}
+   cache.put(key,t);
+  }return t;
+ }
+ public static TextPaint textPaint(int flags){TextPaint p=new TextPaint(flags);p.setTypeface(get(400,false));return p;}
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/fxios/FxMotion.java b/TMessagesProj/src/main/java/org/telegram/ui/fxios/FxMotion.java
