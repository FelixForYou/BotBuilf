+package org.telegram.ui.fxios;
+import android.graphics.Typeface;
+import android.graphics.Outline;
+import android.os.Build;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewOutlineProvider;
+import android.widget.TextView;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.R;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.ui.Components.UniversalRecyclerView;
+/** Shared screen styling, applied at creation/attachment rather than every draw. */
+public final class FxIosStyle {
+ private FxIosStyle() {}
+ public static void applyTree(View v){
+  if(v==null)return;
+  if(v.getTag(R.id.fxbgram_ios_styled)==null){
+   v.setTag(R.id.fxbgram_ios_styled,Boolean.TRUE);
+   if(v instanceof TextView){TextView t=(TextView)v;Typeface old=t.getTypeface();
+    if(old!=Typeface.MONOSPACE)t.setTypeface(FxIosTypography.get(old!=null&&(Build.VERSION.SDK_INT>=28?old.getWeight()>=550:old.isBold())?600:400,old!=null&&old.isItalic()));
+   }
+   if(v instanceof RecyclerListView)v.setOverScrollMode(View.OVER_SCROLL_NEVER);
+  }
+  if(v instanceof ViewGroup){ViewGroup g=(ViewGroup)v;for(int i=0;i<g.getChildCount();i++)applyTree(g.getChildAt(i));}
+ }
+ public static void applyScreen(View v,String name){applyTree(v);if(name.contains("Settings")||name.contains("Privacy")||name.contains("Sessions")||name.contains("Proxy")||name.contains("Notifications")||name.contains("Data")||name.contains("Devices")||name.contains("Language")||name.contains("Folders")||name.contains("Filters")||name.contains("Appearance")||name.contains("TwoStep")||name.contains("Passcode")||name.contains("AutoDownload")||name.contains("Storage"))groupLists(v);}
+ private static void groupLists(View v){
+  if(v==null)return;
+  if(v instanceof RecyclerListView&&v.getTag(R.id.fxbgram_ios_grouped)==null){v.setTag(R.id.fxbgram_ios_grouped,Boolean.TRUE);((RecyclerListView)v).setSections(AndroidUtilities.dp(16),AndroidUtilities.dp(28),false);}
+  if(v instanceof ViewGroup){ViewGroup g=(ViewGroup)v;for(int i=0;i<g.getChildCount();i++)groupLists(g.getChildAt(i));}
+ }
+ public static void roundSheet(View v){if(v==null||Build.VERSION.SDK_INT<21)return;v.setOutlineProvider(new ViewOutlineProvider(){@Override public void getOutline(View v,Outline o){o.setRoundRect(0,0,v.getWidth(),v.getHeight()+AndroidUtilities.dp(28),AndroidUtilities.dp(28));}});v.setClipToOutline(true);applyTree(v);}
+}
