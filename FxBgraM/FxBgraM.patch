index f9a3639..85a6cf7 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -115,11 +115,10 @@ android {
     ndkVersion "27.2.12479018"
 
 
-    externalNativeBuild {
-        cmake {
-            path 'jni/CMakeLists.txt'
-        }
-    }
+    if(!providers.gradleProperty("fxbgramPrebuiltNative").getOrElse("false").toBoolean()){
+        externalNativeBuild { cmake { path 'jni/CMakeLists.txt' } }
+    }else{sourceSets.main.jniLibs.srcDirs += [rootProject.file("fxbgram-native")]}
+
 
     lintOptions {
         disable 'MissingTranslation'
@@ -135,6 +134,26 @@ android {
     }
 
     defaultConfig {
+        // Owner configuration, embedded during compilation; never requested from users.
+        def fxProps = new Properties()
+        def fxFile = rootProject.file("fxbgram.local.properties")
+        if (fxFile.exists()) fxFile.withInputStream { fxProps.load(it) }
+        def fxId = System.getenv("FXBGRAM_API_ID") ?: fxProps.getProperty("api_id", "0")
+        def fxHash = System.getenv("FXBGRAM_API_HASH") ?: fxProps.getProperty("api_hash", "")
+        if (!(fxId ==~ /[0-9]+/) || !(fxHash ==~ /[a-fA-F0-9]{32}/)) {
+            throw new GradleException("FxBgraM requires the owner's API ID and 32-character API Hash in fxbgram.local.properties or FXBGRAM_API_ID / FXBGRAM_API_HASH.")
+        }
+        if (Long.parseLong(fxId) <= 0 || Long.parseLong(fxId) > Integer.MAX_VALUE) {
+            throw new GradleException("FxBgraM API ID is outside the supported range.")
+        }
+        buildConfigField "int", "FXBGRAM_API_ID", fxId
+        buildConfigField "String", "FXBGRAM_API_HASH", "\"${fxHash}\""
+
+        // This build targets the owner's ARM64 Android phone.
+        ndk {
+            abiFilters "arm64-v8a"
+        }
+
         minSdkVersion 23
         targetSdkVersion 36
 
