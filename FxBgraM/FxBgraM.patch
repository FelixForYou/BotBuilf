@@ -0,0 +1,133 @@
+package org.telegram.ui.fxios;
+
+import android.content.Context;
+import android.view.View;
+
+import java.util.ArrayList;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalRecyclerView;
+import org.telegram.ui.LiteModeSettingsActivity;
+
+/** FxBgraM "Glass & Motion": Liquid Glass level, animation quality, touch feedback and tools. */
+public class FxIosSettingsActivity extends BaseFragment {
+    private static final int ID_HAPTICS = 1, ID_PRESS = 2;
+    private static final int ID_GLASS_BASE = 100;   // + FxMotion.GLASS_*
+    private static final int ID_MOTION_BASE = 200;  // + FxMotion.MOTION_*
+    private static final int ID_DOWNLOADS = 300, ID_POWER = 301;
+
+    private UniversalRecyclerView list;
+    private FxGlassPreviewView preview;
+    private int previewStep = 1;
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setTitle(LocaleController.getString(R.string.FxIosEnhancements));
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) finishFragment();
+            }
+        });
+        preview = new FxGlassPreviewView(context);
+        list = new UniversalRecyclerView(this, this::fill, this::click, (i, v, p, x, y) -> false);
+        list.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        list.setSections(AndroidUtilities.dp(16), AndroidUtilities.dp(14), false);
+        fragmentView = list;
+        return fragmentView;
+    }
+
+    private static String glassName(int level) {
+        switch (level) {
+            case FxMotion.GLASS_RICH: return LocaleController.getString(R.string.FxGlassRich);
+            case FxMotion.GLASS_STANDARD: return LocaleController.getString(R.string.FxGlassStandard);
+            case FxMotion.GLASS_SIMPLE: return LocaleController.getString(R.string.FxGlassSimple);
+            case FxMotion.GLASS_OFF: return LocaleController.getString(R.string.FxGlassOff);
+            default: return LocaleController.getString(R.string.FxGlassAuto);
+        }
+    }
+
+    private static String motionName(int mode) {
+        switch (mode) {
+            case FxMotion.MOTION_FULL: return LocaleController.getString(R.string.FxMotionFull);
+            case FxMotion.MOTION_REDUCED: return LocaleController.getString(R.string.FxMotionReduced);
+            case FxMotion.MOTION_OFF: return LocaleController.getString(R.string.FxMotionOff);
+            default: return LocaleController.getString(R.string.FxGlassAuto);
+        }
+    }
+
+    private void fill(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asCustom(preview));
+        items.add(UItem.asShadow(LocaleController.getString(R.string.FxPreviewHint)));
+
+        final int glass = FxMotion.getGlassSetting();
+        items.add(UItem.asHeader(LocaleController.getString(R.string.FxGlassHeader)));
+        items.add(UItem.asRadio(ID_GLASS_BASE + FxMotion.GLASS_AUTO, LocaleController.getString(R.string.FxGlassAuto),
+            LocaleController.formatString(R.string.FxGlassAutoValue, glassName(FxMotion.autoGlass()))).setChecked(glass == FxMotion.GLASS_AUTO));
+        for (int level : new int[]{FxMotion.GLASS_RICH, FxMotion.GLASS_STANDARD, FxMotion.GLASS_SIMPLE, FxMotion.GLASS_OFF}) {
+            UItem item = UItem.asRadio(ID_GLASS_BASE + level, glassName(level)).setChecked(glass == level);
+            if (android.os.Build.VERSION.SDK_INT < 31 && (level == FxMotion.GLASS_RICH || level == FxMotion.GLASS_STANDARD)) {
+                item.setEnabled(false);
+            }
+            items.add(item);
+        }
+        items.add(UItem.asShadow(LocaleController.getString(R.string.FxIosGlassInfo)));
+
+        final int motion = FxMotion.getMotionSetting();
+        items.add(UItem.asHeader(LocaleController.getString(R.string.FxMotionHeader)));
+        items.add(UItem.asRadio(ID_MOTION_BASE + FxMotion.MOTION_AUTO, LocaleController.getString(R.string.FxGlassAuto),
+            LocaleController.formatString(R.string.FxGlassAutoValue, motionName(FxMotion.autoMotion()))).setChecked(motion == FxMotion.MOTION_AUTO));
+        for (int mode : new int[]{FxMotion.MOTION_FULL, FxMotion.MOTION_REDUCED, FxMotion.MOTION_OFF}) {
+            items.add(UItem.asRadio(ID_MOTION_BASE + mode, motionName(mode)).setChecked(motion == mode));
+        }
+        items.add(UItem.asShadow(LocaleController.getString(R.string.FxMotionInfo)));
+
+        items.add(UItem.asHeader(LocaleController.getString(R.string.FxTouchHeader)));
+        items.add(UItem.asCheck(ID_HAPTICS, LocaleController.getString(R.string.FxIosHaptics)).setChecked(FxIosExperience.haptics()));
+        items.add(UItem.asCheck(ID_PRESS, LocaleController.getString(R.string.FxIosPress)).setChecked(FxIosExperience.pressAnimations()));
+        items.add(UItem.asShadow(LocaleController.getString(R.string.FxIosEnhancementsInfo)));
+
+        items.add(UItem.asHeader(LocaleController.getString(R.string.FxToolsHeader)));
+        items.add(UItem.asButton(ID_DOWNLOADS, R.drawable.fx_downloads_24, LocaleController.getString(R.string.FxDownloadsTitle)));
+        items.add(UItem.asButton(ID_POWER, R.drawable.msg2_battery, LocaleController.getString(R.string.FxPowerSavingLink)));
+        items.add(UItem.asShadow(null));
+    }
+
+    private void click(UItem item, View view, int position, float x, float y) {
+        final int id = item.id;
+        if (id == ID_HAPTICS) {
+            FxIosExperience.setHaptics(!FxIosExperience.haptics());
+        } else if (id == ID_PRESS) {
+            FxIosExperience.setPressAnimations(!FxIosExperience.pressAnimations());
+        } else if (id >= ID_GLASS_BASE && id <= ID_GLASS_BASE + FxMotion.GLASS_RICH) {
+            if (!item.enabled) return;
+            FxMotion.setGlassSetting(id - ID_GLASS_BASE);
+            preview.invalidate();
+            // Glass surfaces are created together with their screens: rebuild the screens
+            // underneath this one (not this one) so the new level applies everywhere.
+            if (parentLayout != null) parentLayout.rebuildAllFragmentViews(false, false);
+        } else if (id >= ID_MOTION_BASE && id <= ID_MOTION_BASE + FxMotion.MOTION_OFF) {
+            FxMotion.setMotionSetting(id - ID_MOTION_BASE);
+            preview.moveTo(++previewStep % 3);
+        } else if (id == ID_DOWNLOADS) {
+            presentFragment(new FxDownloadsActivity());
+            return;
+        } else if (id == ID_POWER) {
+            presentFragment(new LiteModeSettingsActivity());
+            return;
+        } else {
+            return;
+        }
+        FxIosExperience.selection(view);
+        list.adapter.update(true);
+    }
+
+}
