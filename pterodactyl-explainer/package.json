{
  "name": "pterodactyl-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Visual explainer (5 min, 1080p60) tentang Pterodactyl Panel untuk bot Telegram & WhatsApp — dibuat dengan Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "tts": "python3 scripts/gen_tts.py",
    "sfx": "python3 scripts/gen_sfx.py",
    "timeline": "python3 scripts/build_timeline.py",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts PterodactylExplainer out/pterodactyl-explainer.mp4 --codec=h264 --crf=20 --concurrency=4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "^4.0.540",
    "lucide": "^1.67.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.540",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "5.9"
  }
}
