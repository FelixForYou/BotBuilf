<?xml version="1.0" encoding="utf-8"?>
<!-- A browser must open plain-HTTP sites (LAN devices, IP-only servers),
     like Chrome does. HTTPS pages are unaffected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
