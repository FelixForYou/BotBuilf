# =============================================================================
# FxB RestApi — FELIXIORITY
# Salin ke .env.local (lokal) atau isi di Vercel › Settings › Environment Variables.
# Semua variabel opsional kecuali yang ditandai WAJIB (produksi).
# Endpoint yang butuh provider akan berstatus "Belum aktif" (503) bila env-nya kosong.
# =============================================================================

# --- Inti -------------------------------------------------------------------
# WAJIB di produksi: database Turso (libSQL). Kosong saat lokal → file data/fxb.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# WAJIB: string acak ≥ 32 karakter (dipakai untuk hash IP di log). `openssl rand -base64 48`
SESSION_SECRET=
# URL publik (dipakai untuk link short URL, file upload, redirect pembayaran)
APP_URL=https://fxb-restapi.vercel.app
# Email yang otomatis menjadi admin saat mendaftar. Kosong → user pertama jadi admin.
ADMIN_EMAIL=
# Link kontak di tombol bantuan (WhatsApp/Telegram), opsional
NEXT_PUBLIC_SUPPORT_URL=
# Batas upload file (MB) — Vercel membatasi body ±4.5 MB
MAX_UPLOAD_MB=4
LOG_RETENTION_DAYS=90

# --- AI (minimal satu provider) ----------------------------------------------
# Anthropic Claude (SDK resmi). Default model: claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
# Provider OpenAI-compatible (OpenAI, Groq, OpenRouter, Together, dll)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=
# Model default untuk key free (harus salah satu model di atas)
AI_DEFAULT_MODEL=

# --- Downloader ---------------------------------------------------------------
# Instance Cobalt milik sendiri (https://github.com/imputnet/cobalt) untuk IG/YT/FB/Pinterest/X/SoundCloud/AIO
COBALT_API_URL=
COBALT_API_KEY=
# TikTok & profil TikTok (default https://www.tikwm.com)
TIKWM_API_URL=

# --- AI Image -----------------------------------------------------------------
# Text-to-image (default https://image.pollinations.ai). Token opsional untuk limit lebih tinggi.
POLLINATIONS_URL=
POLLINATIONS_TOKEN=
# remove.bg — Background Remover
REMOVEBG_API_KEY=
# Replicate — format "owner/model" (model resmi) atau "owner/model:versionhash"
REPLICATE_API_TOKEN=
REPLICATE_UPSCALE_MODEL=
REPLICATE_ENHANCE_MODEL=
REPLICATE_ENHANCE_IMAGE_KEY=img
REPLICATE_IMG2IMG_MODEL=
REPLICATE_IMG2IMG_IMAGE_KEY=image

# --- Tools ------------------------------------------------------------------
# Opsional: menaikkan rate limit GitHub API (stalk/github)
GITHUB_TOKEN=
# Opsional: Microlink Pro untuk screenshot (tanpa key = kuota gratis Microlink)
MICROLINK_API_KEY=

# --- Pembayaran ---------------------------------------------------------------
# Midtrans Snap. Webhook: https://DOMAIN/api/payments/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Xendit Invoice. Webhook: https://DOMAIN/api/payments/xendit (header x-callback-token)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Transfer manual diaktifkan dari Admin › Pengaturan (isi instruksi pembayaran).
