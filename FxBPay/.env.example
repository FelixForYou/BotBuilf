# ── FxB Pay — contoh konfigurasi. JANGAN commit file .env berisi nilai asli. ──

# PostgreSQL (wajib)
DATABASE_URL=postgres://fxb:ganti-password@localhost:5432/fxbpay
# DATABASE_SSL=1            # aktifkan untuk database terkelola (Neon, RDS, Supabase, dll.)
# DB_POOL_MAX=10

# URL publik aplikasi (wajib di production, harus https:// agar cookie Secure & DANA bisa mengirim notifikasi)
APP_URL=https://pay.domainanda.com

# Kunci enkripsi AES-256-GCM untuk kredensial DANA & secret webhook (32 byte base64).
# Buat dengan: npm run keygen   — SIMPAN CADANGANNYA; jika hilang, kredensial tersimpan tidak bisa dibuka.
APP_ENCRYPTION_KEY=

# Rahasia untuk endpoint /api/cron (platform serverless tanpa worker)
CRON_SECRET=

# Email (wajib di production untuk verifikasi email & reset password)
# SMTP_URL=smtps://user:password@smtp.penyedia.com:465
# MAIL_FROM="FxB Pay <no-reply@domainanda.com>"

# Rate limit API merchant per key per menit
# API_RATE_LIMIT_PER_MIN=120

# Set 0 bila aplikasi TIDAK berada di belakang reverse proxy tepercaya (X-Forwarded-For diabaikan)
# TRUST_PROXY=1

# Hanya development: izinkan URL webhook http/localhost untuk uji lokal
# ALLOW_PRIVATE_WEBHOOK_URLS=1

# Catatan: kredensial DANA TIDAK disimpan di .env. Masukkan lewat Admin → Pengaturan DANA
# (disimpan terenkripsi di database, terpisah untuk Sandbox dan Production).
